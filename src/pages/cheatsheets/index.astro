---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionBand from '@/components/SectionBand.astro';

const cheatsheets = (await getCollection('cheatsheets', ({ data }) => !data.draft))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const categories = [...new Set(cheatsheets.map(c => c.data.category))].sort();

const byCategory = Object.fromEntries(
  categories.map(cat => [cat, cheatsheets.filter(c => c.data.category === cat)])
);

const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
---
<BaseLayout path="/cheatsheets" title="Cheatsheets" description="Quick reference guides for pentest tools, AD attacks, privilege escalation, and Windows internals.">
  <div style="padding-top: 88px;">
    <SectionBand
      num="07"
      label="Reference"
      title="Cheatsheets"
      meta={`<b>${String(cheatsheets.length).padStart(2, '0')}</b> sheets<br>${categories.length} categories`}
    />
  </div>

  <div class="container section-body">
    <p class="section-desc rv">Quick reference guides for the tools and techniques I use most — pentest commands, attack paths, and Windows internals.</p>

    {categories.length > 0 && (
      <nav class="cheat-category-nav" aria-label="Cheatsheet categories">
        {categories.map((cat, index) => (
          <a href={`#category-${index + 1}`}>
            {cat}<span class="cheat-category-total">{byCategory[cat].length}</span>
          </a>
        ))}
      </nav>
    )}

    {categories.map((cat, index) => (
      <section class="cheat-group rv" id={`category-${index + 1}`} aria-labelledby={`category-title-${index + 1}`}>
        <h3 class="cheat-group-title" id={`category-title-${index + 1}`}>{cat}</h3>
        <span class="cheat-group-count">{byCategory[cat].length} sheet{byCategory[cat].length === 1 ? '' : 's'}</span>

        <div class="research">
          {byCategory[cat].map((c, i) => (
            <a class="writeup" href={`/cheatsheets/${c.id}`}>
              <span class="writeup-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="writeup-meta">
                <span class="date">{fmt(c.data.updated)}</span>
                <span class="type">{c.data.category}</span>
              </div>
              <div class="writeup-main">
                <h3>{c.data.title}</h3>
                <p>{c.data.description}</p>
                {c.data.tools.length > 0 && (
                  <div class="cheat-tools">
                    {c.data.tools.map(t => <span class="tag">{t}</span>)}
                  </div>
                )}
              </div>
              <span class="writeup-arrow">→</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    {cheatsheets.length === 0 && (
      <p class="section-desc">No cheatsheets yet. Coming soon.</p>
    )}
  </div>
</BaseLayout>

<style>
  .cheat-category-nav { display: flex; gap: 10px; overflow-x: auto; padding: 4px 2px 14px; margin-bottom: 32px; }
  .cheat-category-nav a { display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0; padding: 10px 14px; border: 1px solid var(--ink-2); border-radius: 4px; color: var(--ink); font: 12px var(--font-mono); text-decoration: none; }
  .cheat-category-nav a:hover, .cheat-category-nav a:focus-visible { color: var(--accent); border-color: var(--accent); }
  .cheat-category-total { color: var(--ink-2); font-size: 11px; }
  .cheat-group { scroll-margin-top: 110px; }
  .cheat-group:target .cheat-group-title { color: var(--accent); }
</style>
