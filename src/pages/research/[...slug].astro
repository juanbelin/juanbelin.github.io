---
import { getCollection, render } from 'astro:content';
import { readingMinutes, countWords } from '@/lib/reading-time.mjs';
import ArticleLayout from '@/layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('research', ({ data }) => !data.draft);
  return writeups.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Prefer shared categories, then shared tags, then recent posts when a
// category has no other entries. Never recommend the current post or drafts.
const categoryNames = new Set(entry.data.categories.map(category => category.toLowerCase()));
const tagNames = new Set(entry.data.tags.map(tag => tag.toLowerCase()));
const relatedPosts = (await getCollection('research', ({ data }) => !data.draft))
  .filter(candidate => candidate.id !== entry.id)
  .map(candidate => ({
    entry: candidate,
    categoryMatches: candidate.data.categories.filter(category => categoryNames.has(category.toLowerCase())).length,
    tagMatches: candidate.data.tags.filter(tag => tagNames.has(tag.toLowerCase())).length,
  }))
  .sort((a, b) => b.categoryMatches - a.categoryMatches || b.tagMatches - a.tagMatches || b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
  .slice(0, 2)
  .map(candidate => candidate.entry);

const meta: string[] = [];
if (entry.data.difficulty) meta.push(entry.data.difficulty);
meta.push(`${readingMinutes(entry.body)} min read`);
---
<ArticleLayout
  wordCount={countWords(entry.body)}
  headings={headings}
  relatedPosts={relatedPosts}
  sharePath={entry.data.legacySlug ? `/posts/${encodeURIComponent(entry.data.legacySlug)}/` : undefined}
  title={entry.data.title}
  description={entry.data.description}
  type={entry.data.type}
  date={entry.data.date}
  meta={meta}
  video={entry.data.video}
  image={entry.data.image}
  categories={entry.data.categories}
  tags={entry.data.tags}
  ledger="/research"
>
  <Content />
</ArticleLayout>
