---
import { getCollection } from 'astro:content';
import ResearchIndex from '@/components/ResearchIndex.astro';
import { RESEARCH_PAGE_SIZE } from '@/lib/research-pagination.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('research', ({ data }) => !data.draft);
  const totalPages = Math.ceil(entries.length / RESEARCH_PAGE_SIZE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
---
<ResearchIndex currentPage={Number(Astro.params.page)} />
