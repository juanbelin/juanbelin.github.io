---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout path="/404" title="Page not found" description="This page could not be found. Explore Juan Belinchón’s research, projects and security notes." noindex>
  <main class="container not-found">
    <div class="not-found-content rv">
      <p class="band-label">Error / Page not found</p>
      <p class="not-found-code" aria-hidden="true">404<span>_</span></p>
      <h1>Nothing at this address.</h1>
      <p class="not-found-description">The page may have moved, or the link might be incorrect. There’s still plenty to explore.</p>
      <div class="not-found-actions">
        <a class="btn primary" href="/">Back to home <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href="/research/">Explore research <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <p class="not-found-note">Looking for an older write-up? You’ll find it in <a href="/research/">Research</a>.</p>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found { min-height: calc(100svh - 120px); display: flex; align-items: center; padding-top: 144px; padding-bottom: 88px; }
  .not-found-content { width: 100%; max-width: 760px; }
  .not-found-code { margin: 24px 0; font: 400 clamp(120px, 22vw, 240px)/.85 var(--font-display); letter-spacing: -.03em; }
  .not-found-code span { color: var(--accent); }
  h1 { margin-bottom: 20px; font: 400 clamp(32px, 5vw, 52px)/1.15 var(--font-serif); }
  .not-found-description { max-width: 520px; color: var(--ink-2); }
  .not-found-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .not-found-note { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--rule-2); color: var(--ink-2); font: 11px/1.8 var(--font-mono); }
  .not-found-note a { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .not-found-note a:hover { color: var(--accent); }
  @media (max-width: 720px) {
    .not-found { padding-top: 128px; padding-bottom: 64px; }
  }
</style>
