---
import GitHubIcon from '@/components/GitHubIcon.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Ticker from '@/components/Ticker.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import { certs } from '@/data/certs';
import { site } from '@/data/site';

const writeups = (await getCollection('research', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

---
<BaseLayout path="/">

  <section class="hero">
    <div class="container">
      <div class="hero-meta">
        <span class="idx">CASE FILE <b>{site.caseFile}</b></span>
        <span>{site.location} — {site.timezone}</span>
      </div>

      <h1 class="hero-title" aria-label={site.name}>
        {site.nameLines.map(name => (
          <span class="line"><span class="line-inner">{name}</span></span>
        ))}
      </h1>

      <div class="hero-grid">
        <div class="hero-lede-col">
          <div class="hero-portrait">
            <img src={site.photo} alt={site.name} />
          </div>
          <p class="hero-lede">
            {site.bio.split('detections and defenses')[0]}<em>detections and defenses</em>{site.bio.split('detections and defenses')[1]}
          </p>
        </div>

        <div class="hero-col">
          <h4>Credentials</h4>
          <dl>
            {certs.filter(cert => (cert.kind ?? 'certification') === 'certification').map(cert => (
              <div><dt>Cert</dt><dd>{cert.name}</dd></div>
            ))}
            <div><dt>Training</dt><dd>HTB Academy · Improving Red teaming</dd></div>
          </dl>
        </div>

        <div class="hero-col">
          <h4>Navigate</h4>
          <div class="hero-actions">
            <a href="/research" class="btn primary">Journal <span class="arrow">→</span></a>
            <a href="/contact" class="btn">Contact <span class="arrow">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="stats">
    <div class="stats-inner">
      {site.stats.map(s => (
        <div class="stat">
          <span class="num">{s.num}</span>
          <span class="lbl" set:html={s.lbl} />
        </div>
      ))}
    </div>
  </div>

  <Ticker />

  <section class="section">
    <div class="container" style="padding-top: 64px; padding-bottom: 64px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 40px; gap: 24px; flex-wrap: wrap;">
        <div>
          <span class="band-label">Journal</span>
          <h2 class="band-title" style="font-size: 40px; margin-top: 8px;">Latest research <svg class="section-title-icon fa-solid fa-file-pen" viewBox="0 0 576 512" fill="currentColor" aria-hidden="true"><path d="M0 64C0 28.7 28.7 0 64 0L224 0l0 128c0 17.7 14.3 32 32 32l128 0 0 125.7-86.8 86.8c-10.3 10.3-17.5 23.1-21 37.2l-18.7 74.9c-2.3 9.2-1.8 18.8 1.3 27.5L64 512c-35.3 0-64-28.7-64-64L0 64zm384 64l-128 0L256 0 384 128zM549.8 235.7l14.4 14.4c15.6 15.6 15.6 40.9 0 56.6l-29.4 29.4-71-71 29.4-29.4c15.6-15.6 40.9-15.6 56.6 0zM311.9 417L441.1 287.8l71 71L382.9 487.9c-4.1 4.1-9.2 7-14.9 8.4l-60.1 15c-5.5 1.4-11.2-.2-15.2-4.2s-5.6-9.7-4.2-15.2l15-60.1c1.4-5.6 4.3-10.8 8.4-14.9z" /></svg></h2>
        </div>
        <a href="/research" class="btn">All research <span class="arrow">→</span></a>
      </div>

      <div class="research">
        {writeups.map(entry => <ResearchCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="padding-top: 64px; padding-bottom: 64px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 40px; gap: 24px; flex-wrap: wrap;">
        <div>
          <span class="band-label">Builds</span>
          <h2 class="band-title" style="font-size: 40px; margin-top: 8px;">Recent projects <svg class="section-title-icon fa-solid fa-code" viewBox="0 0 640 512" fill="currentColor" aria-hidden="true"><path d="M392.8 1.2c-17-4.9-34.7 5-39.6 22l-128 448c-4.9 17 5 34.7 22 39.6s34.7-5 39.6-22l128-448c4.9-17-5-34.7-22-39.6zm80.6 112.1c-12.5 12.5-12.5 32.8 0 45.3L570.7 256l-97.4 97.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l120-120c12.5-12.5 12.5-32.8 0-45.3l-120-120c-12.5-12.5-32.8-12.5-45.3 0zm-306.8 0c-12.5-12.5-32.8-12.5-45.3 0l-120 120c-12.5 12.5-12.5 32.8 0 45.3l120 120c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L69.3 256l97.4-97.4c12.5-12.5 12.5-32.8 0-45.3z" /></svg></h2>
        </div>
        <a href="/projects" class="btn">All projects <span class="arrow">→</span></a>
      </div>

      {projects.length === 0 && (
        <p class="section-desc">GitHub projects coming soon. <a href="https://github.com/juanbelin?tab=repositories" target="_blank" rel="noopener noreferrer">Browse my repositories →</a></p>
      )}
      <div class="projects">
        {projects.map(p => (
          <article class="project rv">
            <div class="project-head">
              <span class={`project-status ${p.data.status}`}>
                {p.data.status.toUpperCase()}
              </span>
              <span class="project-year">GitHub</span>
            </div>
            <h3><a href={`/projects/${p.id}`} style="color:inherit">{p.data.title}</a></h3>
            <p>{p.data.description}</p>
            <div class="project-foot">
              <div class="project-tags">
                {p.data.stack.map(t => <span class="tag">{t}</span>)}
              </div>
              <div class="project-links">
                {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener noreferrer" class="repository-link">Repository <GitHubIcon /></a>}
                <a href={`/projects/${p.id}`}>Details →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="padding: 96px 0 80px; text-align: center;">
      <span class="band-label">Say hi</span>
      <h2 class="band-title" style="font-size: clamp(40px, 6vw, 80px); margin: 24px 0 32px;">
        Open to opportunities<br>worth pursuing.
      </h2>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn primary">Get in touch <span class="arrow">→</span></a>
        <a href="/profile" class="btn">See profile <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section-title-icon {
    display: inline-block;
    width: auto;
    height: 0.65em;
    margin-left: 0.15em;
    vertical-align: baseline;
  }
</style>
