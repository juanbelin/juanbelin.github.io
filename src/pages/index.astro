---
import GitHubIcon from '@/components/GitHubIcon.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Ticker from '@/components/Ticker.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import { certs } from '@/data/certs';
import { site } from '@/data/site';

const writeups = (await getCollection('research', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

---
<BaseLayout path="/">

  <section class="hero">
    <div class="container">
      <div class="hero-meta">
        <span class="idx">CASE FILE <b>{site.caseFile}</b></span>
        <span>{site.location} — {site.timezone}</span>
      </div>

      <h1 class="hero-title" aria-label={site.name}>
        {site.nameLines.map(name => (
          <span class="line"><span class="line-inner">{name}</span></span>
        ))}
      </h1>

      <div class="hero-grid">
        <div class="hero-lede-col">
          <div class="hero-portrait">
            <img src={site.photo} alt={site.name} />
          </div>
          <p class="hero-lede">
            {site.bio.split('detections and defenses')[0]}<em>detections and defenses</em>{site.bio.split('detections and defenses')[1]}
          </p>
        </div>

        <div class="hero-col">
          <h4>Credentials</h4>
          <dl>
            {certs.filter(cert => (cert.kind ?? 'certification') === 'certification').map(cert => (
              <div><dt>Cert</dt><dd>{cert.name}</dd></div>
            ))}
            <div><dt>Training</dt><dd>HTB Academy · Improving Red teaming</dd></div>
          </dl>
        </div>

        <div class="hero-col">
          <h4>Navigate</h4>
          <div class="hero-actions">
            <a href="/research" class="btn primary">Journal <span class="arrow">→</span></a>
            <a href="/contact" class="btn">Contact <span class="arrow">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="stats">
    <div class="stats-inner">
      {site.stats.map(s => (
        <div class="stat">
          <span class="num">{s.num}</span>
          <span class="lbl" set:html={s.lbl} />
        </div>
      ))}
    </div>
  </div>

  <Ticker />

  <section class="section">
    <div class="container" style="padding-top: 64px; padding-bottom: 64px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 40px; gap: 24px; flex-wrap: wrap;">
        <div>
          <span class="band-label">Journal</span>
          <h2 class="band-title" style="font-size: 40px; margin-top: 8px;">Latest research</h2>
        </div>
        <a href="/research" class="btn">All research <span class="arrow">→</span></a>
      </div>

      <div class="research">
        {writeups.map(entry => <ResearchCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="padding-top: 64px; padding-bottom: 64px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 40px; gap: 24px; flex-wrap: wrap;">
        <div>
          <span class="band-label">Builds</span>
          <h2 class="band-title" style="font-size: 40px; margin-top: 8px;">Recent projects</h2>
        </div>
        <a href="/projects" class="btn">All projects <span class="arrow">→</span></a>
      </div>

      {projects.length === 0 && (
        <p class="section-desc">GitHub projects coming soon. <a href="https://github.com/juanbelin?tab=repositories" target="_blank" rel="noopener noreferrer">Browse my repositories →</a></p>
      )}
      <div class="projects">
        {projects.map(p => (
          <article class="project rv">
            <div class="project-head">
              <span class={`project-status ${p.data.status}`}>
                {p.data.status.toUpperCase()}
              </span>
              <span class="project-year">GitHub</span>
            </div>
            <h3><a href={`/projects/${p.id}`} style="color:inherit">{p.data.title}</a></h3>
            <p>{p.data.description}</p>
            <div class="project-foot">
              <div class="project-tags">
                {p.data.stack.map(t => <span class="tag">{t}</span>)}
              </div>
              <div class="project-links">
                {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener noreferrer" class="repository-link">Repository <GitHubIcon /></a>}
                <a href={`/projects/${p.id}`}>Details →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="padding: 96px 0 80px; text-align: center;">
      <span class="band-label">Say hi</span>
      <h2 class="band-title" style="font-size: clamp(40px, 6vw, 80px); margin: 24px 0 32px;">
        Open to opportunities<br>worth pursuing.
      </h2>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn primary">Get in touch <span class="arrow">→</span></a>
        <a href="/profile" class="btn">See profile <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

</BaseLayout>
