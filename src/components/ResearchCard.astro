---
import { readingMinutes } from '@/lib/reading-time.mjs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'research'>;
  showCover?: boolean;
}
const { entry, showCover = true } = Astro.props;
const { title, description, date, categories, tags, image, pin } = entry.data;
const readingTime = readingMinutes(entry.body);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
});
---
<a class="research-card rv" href={`/research/${entry.id}`}
  data-research-card data-with-cover={showCover && image ? true : undefined} data-categories={JSON.stringify(categories)} data-tags={JSON.stringify(tags)}>
  {showCover && image && <div class="research-card-media"><img class="research-card-cover" src={image} alt="" width="480" height="360" loading="lazy" /></div>}
  <div class="research-card-body">
    <div class="research-card-meta">
      <time datetime={date.toISOString()}>
        <!-- Font Awesome Free calendar, Classic Solid (CC BY 4.0, Fonticons, Inc.). -->
        <svg class="fa-solid fa-calendar" width="10" height="12" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
          <path d="M128 0c17.7 0 32 14.3 32 32v32h128V32c0-17.7 14.3-32 32-32s32 14.3 32 32v32h48c26.5 0 48 21.5 48 48v48H0v-48c0-26.5 21.5-48 48-48h48V32c0-17.7 14.3-32 32-32zM0 192h448v272c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V192z" />
        </svg>
        {fmt(date)}
      </time>

      {readingTime && <><span class="research-card-separator" aria-hidden="true">·</span><span>{readingTime} min read</span></>}
      {pin && <span class="research-pinned" role="img" aria-label="Pinned post" title="Pinned post">
        <svg class="fa-sharp fa-solid fa-thumbtack-angle" width="14" height="14" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
          <path transform="rotate(45 256 256)" d="M128 48h256v48h-32v144l64 64v48H280v112l-24 32-24-32V352H96v-48l64-64V96h-32z" />
        </svg>
      </span>}
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    {categories.length > 0 && (
      <div class="research-card-categories">{categories.join(' / ')}</div>
    )}
    {tags.length > 0 && (
      <div class="research-card-tags">{tags.map(tag => <span>#{tag}</span>)}</div>
    )}
  </div>
</a>
