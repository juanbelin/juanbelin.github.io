<dialog class="image-lightbox" data-image-gallery aria-label="Post image gallery">
  <div class="gallery-toolbar">
    <span class="gallery-counter" data-gallery-counter role="status" aria-live="polite"></span>
    <a data-gallery-original target="_blank" rel="noopener noreferrer">Open original →</a>
    <button type="button" class="gallery-close" data-gallery-close aria-label="Close image gallery">✕</button>
  </div>
  <div class="gallery-stage" data-gallery-backdrop>
    <button type="button" class="gallery-previous" data-gallery-previous aria-label="Previous image">←</button>
    <figure>
      <img data-gallery-image alt="" />
      <figcaption data-gallery-caption></figcaption>
    </figure>
    <button type="button" class="gallery-next" data-gallery-next aria-label="Next image">→</button>
  </div>
  <p class="gallery-hint">Use ← / → to navigate · Esc to close</p>
</dialog>
